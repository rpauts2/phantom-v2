bind: "0.0.0.0"
https_port: 443
shared_443: false # true = один 443 proxy+stealth API по Host (prod); false = split 8443+8080 (lab default)
node_id: "" # пусто = hostname; или env PHANTOM_NODE_ID (видно в логах/событиях/captures)
domains:
  - "login.example.com"
storage:
  sqlite_path: "./data/phantom.db"
  redis_addr: "127.0.0.1:6379"
  session_ttl_min: 60
tls:
  email: "ops@example.com"
  dns_provider: "disabled"
  wildcard: false
  upstream_tls: "default" # chrome = uTLS HelloChrome+H2 к апстриму (требует H2-апстрим)
api:
  stealth_hostname: "api-internal.example.com"
  ca_file: "./certs/ca.pem"
  cert_file: "./certs/server.pem"
  key_file: "./certs/server-key.pem"
notifications:
  telegram_enabled: false
  chat_id: "" # или env TELEGRAM_CHAT_ID; токен только env TELEGRAM_BOT_TOKEN
log_level: "info"
